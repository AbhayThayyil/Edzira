{#- Responsive photo with AVIF/WebP sources. Until a photo named `name` exists in
    src/assets/photos, a branded placeholder panel renders in its place.
    Import with: {% from "partials/photo.njk" import photo with context %} -#}
{%- macro photo(name, alt, sizes="100vw", eager=false, cls="") -%}
{%- set widths = photos[name] -%}
{%- if widths and widths.length -%}
<picture class="photo {{ cls }}">
  <source type="image/avif" srcset="{% for w in widths %}/assets/photos/{{ name }}-{{ w }}.avif {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">
  <source type="image/webp" srcset="{% for w in widths %}/assets/photos/{{ name }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">
  <img src="/assets/photos/{{ name }}-{{ widths[0] }}.webp" alt="{{ alt }}" width="1600" height="1067" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
</picture>
{%- else -%}
<div class="photo photo--placeholder {{ cls }}" role="img" aria-label="{{ alt }}" data-photo="{{ name }}">
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M250 290C120 300 40 220 50 140 60 60 160 10 300 30" fill="none" stroke="url(#ph-g)" stroke-width="3"/><circle cx="306" cy="32" r="6" fill="#22D3EE"/><defs><linearGradient id="ph-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7DF3FF"/><stop offset="1" stop-color="#2563EB"/></linearGradient></defs></svg>
  <span>Photo: {{ name }}</span>
</div>
{%- endif -%}
{%- endmacro -%}
