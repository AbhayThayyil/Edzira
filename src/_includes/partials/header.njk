{% from "partials/icons.njk" import arrow, chevron %}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="{{ site.name }} home">
      <picture>
        <source type="image/webp" srcset="/assets/img/edzira-logo-240.webp 240w, /assets/img/edzira-logo-480.webp 480w" sizes="118px">
        <img src="/assets/img/edzira-logo-480.png" alt="Edzira" width="1147" height="663" fetchpriority="high" decoding="async">
      </picture>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span></span><span class="visually-hidden">Menu</span></button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav__list">
        <li class="nav__item nav__item--menu" data-open="false">
          <button class="nav__link" type="button" aria-expanded="false" aria-controls="menu-solutions"{% if page.url.startsWith('/solutions/') %} aria-current="page"{% endif %}>Solutions {{ chevron() }}</button>
          <ul class="mega" id="menu-solutions">
            {% for s in nav.solutions %}<li><a href="{{ s.href }}"><strong>{{ s.title }}</strong><span>{{ s.blurb }}</span></a></li>{% endfor %}
            <li><a href="/solutions/"><strong>All solutions</strong><span>See how the pieces connect.</span></a></li>
          </ul>
        </li>
        {% for item in nav.main %}
        <li class="nav__item"><a class="nav__link" href="{{ item.href }}"{% if page.url == item.href or (item.href != '/' and page.url.startsWith(item.href)) %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {% endfor %}
      </ul>
      <a class="btn nav__cta-mobile" href="{{ site.cta.href }}">{{ site.cta.label }} {{ arrow() }}</a>
    </nav>
    {#- A page can relabel the header button (ctaLabel). The default label is stacked invisibly underneath
        so the button keeps the same width and the nav items never move between pages. -#}
    <a class="btn site-header__cta" href="{{ ctaHref or site.cta.href }}"><span class="cta-stack"><span>{{ ctaLabel or site.cta.label }}</span>{% if ctaLabel and ctaLabel != site.cta.label %}<span class="cta-stack__sizer" aria-hidden="true">{{ site.cta.label }}</span>{% endif %}</span> {{ arrow() }}</a>
  </div>
</header>
