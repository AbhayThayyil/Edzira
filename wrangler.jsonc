{
  // Cloudflare deploy settings. The build (`npm run build`) writes the site to _site/,
  // and `npx wrangler deploy` publishes that folder as static files.
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "edzira",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
